{
    email admin@example.com
    debug
}

# Main Domain: Portainer + n8n
example.com {
    # 2. n8n (Automation) - Promoted to Root
    handle {
        reverse_proxy n8n:5678 {
            flush_interval -1
        }
    }
}

# n8n Subdomain (Removed/Commented as DNS failed)
# n8n.example.com {
#    reverse_proxy n8n:5678 {
#        flush_interval -1
#    }
# }

# Windmill (Automation, alternative to n8n -- only needed if you kept the
# windmill_server block in docker-compose.example.yml instead of n8n)
windmill.example.com {
    reverse_proxy windmill_server:8000
}

# Logs (Portainer) - Consolidating Portainer here
logs.example.com {
    reverse_proxy portainer:9000
}


# 5. Chat (Open WebUI)
ai.example.com {
    reverse_proxy open-webui:8080 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote}
    }
}

# 6. Git (Gitea)
git.example.com {
     reverse_proxy gitea:3000
     tls admin@example.com
}

# Status (Uptime Kuma)
status.example.com {
    reverse_proxy uptime-kuma:3001
}

# 9. Files (File Browser)
files.example.com {
    reverse_proxy filebrowser:80
}

# Monitor (Beszel Hub)
monitor.example.com {
     reverse_proxy beszel-hub:8090
}

# Watch (ChangeDetection.io)
watch.example.com {
    reverse_proxy changedetection:5000
}

# Tools (IT-Tools)
tools.example.com {
    reverse_proxy it-tools:80
    basic_auth {
        # Generate your own with: docker exec caddy caddy hash-password
        admin <paste-your-own-bcrypt-hash-here>
    }
}
