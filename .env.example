# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# docker-compose.yml reads these automatically -- Docker Compose loads a
# .env file in the same directory with no extra configuration needed.

# --- Required for Open WebUI ---
# A long random string, used to sign session cookies. Generate one with:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=

# --- Required if you kept Windmill instead of n8n ---
# A password for Windmill's internal Postgres database. Any string works;
# it's never exposed outside the Docker network.
WINDMILL_DB_PASSWORD=

# --- Cloud model keys (optional, but at least one is needed for cloud AI) ---
# Used by n8n/Windmill's AI nodes and Open WebUI's chat models.
# OpenRouter alone covers most models; the others are direct-API alternatives.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# --- Optional: Open WebUI's GitHub-connected features ---
GITHUB_TOKEN=

# --- Optional: protects the Browserless (headless Chrome) endpoint ---
# Only needed if you're keeping ChangeDetection.io, which uses Browserless
# for JS-rendered page checks. Any string works as a shared secret.
BROWSERLESS_TOKEN=

# --- Beszel monitoring (optional) ---
# beszel-agent needs a KEY and TOKEN generated from beszel-hub's own web UI
# *after* beszel-hub is running and you've logged in and added a system --
# not chosen ahead of time. Bring the stack up once, do that in the
# beszel-hub UI, then set these two and restart beszel-agent:
#   docker compose up -d beszel-agent
BESZEL_KEY=
BESZEL_TOKEN=
